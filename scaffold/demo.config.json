{
  "$schema": "demo-video/1",
  "name": "Ma démo",
  "slug": "ma-demo",
  "lang": "fr",
  "fps": 30,
  "width": 1920,
  "height": 1080,
  "window": [60, 120],
  "voiceover": true,
  "titleCard": true,
