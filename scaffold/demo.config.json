  "outro": { "voId": "p99", "tail": 15 },
  "zooms": "baked",
  "cursor": true,
  "sfxClick": true,
  "framewave": {
    "voTrack": "separate",
    "captions": true,
    "markers": true,
    "transitions": { "afterTitle": "fade", "beforeOutro": "fade", "default": "cut", "durationMs": 400 },
    "music": null,
    "musicVolume": 0.12
  },
  "capture": {
    "kind": "artifact",
    "source": "capture/proto.html",
    "cssWidth": 1600,
    "dpr": 2,
    "defaultHeight": 900,
    "chrome": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "profileDir": null
  }
